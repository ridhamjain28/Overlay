# Overlay example settings.
#
# Do NOT put real keys in this file or anywhere in the repository.
# Overlay reads keys from your environment or from the .env file inside its
# user-data folder, for example:
#   %APPDATA%\Overlay\.env              (installed app)
#   %APPDATA%\Overlay-development\.env  (npm run dev)
# Copy only the lines you need into that file.

# Ollama hosted web search (default web-search provider). https://ollama.com/settings/keys
OLLAMA_API_KEY=
# Soft daily cap for Ollama web searches counted on this PC (default 20)
OVERLAY_OLLAMA_SEARCH_DAILY_CAP=20

# Google Gemini (backup answers + Google Search grounding). https://aistudio.google.com/app/apikey
# Overlay moves this key into encrypted storage on first start.
GEMINI_API_KEY=
OVERLAY_GEMINI_MODEL=

# Tavily search (optional). https://app.tavily.com
TAVILY_API_KEY=

# Your own SearxNG instance (optional), e.g. http://127.0.0.1:8888
SEARXNG_URL=

# OpenClaw gateway (optional). The token is a full-access credential.
OPENCLAW_URL=http://127.0.0.1:18789/v1/chat/completions
OPENCLAW_MODEL=openclaw/default
OPENCLAW_TOKEN=
# Only set to 1 if you really need a non-loopback OpenClaw URL
OVERLAY_ALLOW_REMOTE_OPENCLAW=

# Automatic updates are off unless this is 1
OVERLAY_ENABLE_UPDATES=
